# No secrets are required to run this project -- the shipped data connector
# (LocalSyntheticConnector) generates data locally and needs no credentials.
# These are optional overrides for src/churn/config.py; every one has a
# working default and none of them needs to be set for `make data` / `make
# train` to work out of the box.

# CHURN_RANDOM_SEED=42
# CHURN_N_CUSTOMERS=20000
# CHURN_DATA_DIR=./data
# CHURN_MODELS_DIR=./models
# CHURN_MODEL_CONFIG=./configs/model.yaml
# MLFLOW_TRACKING_URI=file:./mlruns
# CHURN_MLFLOW_EXPERIMENT=subscription-churn
